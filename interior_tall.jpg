:root{
  color-scheme:light only;
  --pink:#F5B4BE; --pink-soft:#FBDDE2; --pink-deep:#EC9CA9;
  --sage:#47644F; --green:#2F3E34; --cream:#FAF6EF; --cream-2:#F3ECDF;
  --text:#3A463D; --muted:#6E7C71; --white:#FFFEFB;
  --logo:'Jost',sans-serif; --body:'Hanken Grotesk',-apple-system,sans-serif;
  --ease:cubic-bezier(.22,1,.36,1); --maxw:1200px; --r:32px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;background:var(--cream)}
body{font-family:var(--body);color:var(--text);background:var(--cream);line-height:1.7;font-weight:400;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 26px}

h1,h2,h3,h4{font-weight:600;line-height:1.06;letter-spacing:-.02em;color:var(--green)}
.eyebrow{font-family:var(--body);font-size:.74rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--pink-deep);display:inline-block;margin-bottom:16px}
.h-xl{font-size:clamp(2.6rem,6.5vw,5rem)}
.h-lg{font-size:clamp(2rem,4.4vw,3.3rem)}
.lead{font-size:1.12rem;color:var(--muted);line-height:1.75;max-width:560px}
.center{text-align:center}.center .lead{margin:0 auto}

/* dotted divider motif */
.dotline{display:inline-flex;align-items:center;gap:7px;color:var(--pink-deep)}
.dotline::after{content:"·····";letter-spacing:3px;font-weight:700}

/* logo mark */
.logo{display:inline-flex;flex-direction:column;align-items:center;line-height:1;color:var(--green)}
.logo .rule{width:100%;height:2px;background:currentColor;border-radius:2px}
.logo .stk{font-family:var(--logo);font-weight:500;letter-spacing:.05em;padding:4px 0}
.logo .stk span{display:block;text-align:center}
.logo .tag{font-family:var(--logo);font-weight:500;font-size:.32em;letter-spacing:.28em;text-transform:uppercase;color:var(--sage);margin-top:3px}
.logo--nav{font-size:1.4rem}.logo--nav .stk{font-size:1rem;line-height:.9}
.logo--foot{font-size:1.9rem;color:var(--cream)}.logo--foot .rule{background:var(--cream)}.logo--foot .tag{color:var(--pink)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:var(--body);font-weight:600;
  font-size:.92rem;padding:14px 30px;border-radius:100px;cursor:pointer;border:1.5px solid transparent;
  transition:transform .4s var(--ease),background .3s,color .3s,box-shadow .4s var(--ease);white-space:nowrap}
.btn:hover{transform:translateY(-3px)}
.btn-green{background:var(--green);color:var(--cream)}.btn-green:hover{background:var(--sage);box-shadow:0 14px 28px -12px rgba(47,62,52,.5)}
.btn-pink{background:var(--pink);color:var(--green)}.btn-pink:hover{background:var(--pink-deep);box-shadow:0 14px 28px -12px rgba(236,156,169,.7)}
.btn-out{background:transparent;border-color:var(--green);color:var(--green)}.btn-out:hover{background:var(--green);color:var(--cream)}
.btn-light{background:var(--white);color:var(--green);border-color:rgba(47,62,52,.12)}.btn-light:hover{background:var(--cream-2)}
.btn-wa{background:#25D366;color:#fff}.btn-wa:hover{background:#1ebe5a;box-shadow:0 14px 28px -12px rgba(37,211,102,.6)}
.btn-sm{padding:11px 22px;font-size:.84rem}

/* warning / pre-opening bar */
.alertbar{background:var(--pink);color:var(--green);text-align:center;padding:11px 18px;font-weight:600;
  font-size:.92rem;line-height:1.45;display:flex;align-items:center;justify-content:center;gap:10px}
.alertbar .ic{flex-shrink:0;font-size:1.05rem}
.alertbar strong{font-weight:700}

/* announcement bar */
.topbar{background:var(--green);color:var(--cream);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;
  text-align:center;padding:9px 16px;font-weight:500}
.topbar .dot{color:var(--pink)}

/* nav */
.nav{position:sticky;top:0;z-index:900;background:rgba(250,246,239,.82);backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(47,62,52,.07);transition:padding .4s var(--ease)}
.nav-in{max-width:var(--maxw);margin:0 auto;padding:16px 26px;display:flex;align-items:center;justify-content:space-between}
.nav.tight .nav-in{padding:10px 26px}
.nav-menu{display:flex;align-items:center;gap:28px;list-style:none}
.nav-link{font-size:.93rem;font-weight:500;color:var(--green);position:relative}
.nav-link:not(.nav-cta)::after{content:"";position:absolute;left:0;bottom:-5px;width:0;height:2px;background:var(--pink);transition:width .4s var(--ease)}
.nav-link:not(.nav-cta):hover::after{width:100%}
.nav-cta{background:var(--green);color:var(--cream);padding:10px 22px;border-radius:100px;transition:all .35s var(--ease)}
.nav-cta:hover{background:var(--pink);color:var(--green);transform:translateY(-2px)}
.burger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px}
.burger span{width:25px;height:2px;background:var(--green);border-radius:2px;transition:.35s var(--ease)}
.burger.on span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.burger.on span:nth-child(2){opacity:0}
.burger.on span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* sticker */
.sticker{width:130px;height:130px;animation:spin 24s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* hero */
.hero{padding:70px 0 30px;position:relative}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.hero h1 .sm{display:block;font-size:.42em;font-weight:600;letter-spacing:.01em;color:var(--sage);margin-bottom:6px}
.hero .lead{margin:24px 0 32px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-photo{position:relative}
.hero-photo .ph{border-radius:260px 260px 30px 30px;overflow:hidden;aspect-ratio:47/60;box-shadow:0 40px 80px -34px rgba(47,62,52,.5)}
.hero-photo .ph img{width:100%;height:100%;object-fit:cover}
.hero-photo .sticker{position:absolute;bottom:-26px;left:-32px;z-index:5;filter:drop-shadow(0 14px 26px rgba(47,62,52,.25))}

/* category cards */
.cats{padding:60px 0 30px}
.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.cat{display:block;border-radius:24px;overflow:hidden;position:relative;aspect-ratio:1/1.12;background:var(--cream-2)}
.cat img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}
.cat:hover img{transform:scale(1.06)}
.cat::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(47,62,52,.55),transparent 55%)}
.cat-label{position:absolute;left:24px;right:24px;bottom:22px;z-index:2;color:var(--cream);display:flex;align-items:center;justify-content:space-between;gap:10px}
.cat-label h3{color:var(--cream);font-size:1.4rem}
.cat-arrow{width:38px;height:38px;border-radius:50%;background:var(--pink);color:var(--green);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .4s var(--ease)}
.cat:hover .cat-arrow{transform:translateX(4px) rotate(-45deg)}

/* tagline band */
.tagline{padding:120px 0;text-align:center}
.tagline p{font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.8rem,4.4vw,3.2rem);line-height:1.25;color:var(--green);max-width:900px;margin:0 auto;letter-spacing:-.02em}
.tagline .hl{color:var(--pink-deep);font-weight:400}

/* section base */
.sec{padding:100px 0}
.sec-sm{padding:70px 0}

/* about */
.about-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:64px;align-items:center}
.about-photos{position:relative}
.about-photos .big{border-radius:24px;overflow:hidden;aspect-ratio:1/1.04;box-shadow:0 30px 60px -30px rgba(47,62,52,.4)}
.about-photos .big img{width:100%;height:100%;object-fit:cover}
.about-photos .small{position:absolute;width:50%;aspect-ratio:4/3;border-radius:18px;overflow:hidden;
  bottom:-30px;right:-22px;border:6px solid var(--cream);box-shadow:0 24px 48px -22px rgba(47,62,52,.4)}
.about-photos .small img{width:100%;height:100%;object-fit:cover}
.about p{color:var(--muted);font-size:1.08rem;margin-bottom:16px}
.feat{display:flex;flex-direction:column;gap:2px;margin-top:30px}
.feat-row{display:flex;gap:16px;align-items:flex-start;padding:16px 0;border-top:1px solid rgba(71,100,79,.16)}
.feat-row:last-child{border-bottom:1px solid rgba(71,100,79,.16)}
.feat-ic{flex-shrink:0;width:54px;height:54px;border-radius:50%;background:var(--pink-soft);overflow:hidden;
  display:flex;align-items:center;justify-content:center}
.feat-ic img{width:100%;height:100%;object-fit:cover}
/* thin line icons */
.icon{width:24px;height:24px;stroke:currentColor;stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round;display:block}
.ws-ic{color:var(--green)}.ws-ic .icon{width:30px;height:30px}
.ws.feat .ws-ic{color:var(--green)}
.info-ic{color:var(--sage)}.info-ic .icon{width:20px;height:20px}
.mi{width:14px;height:14px;stroke:var(--sage);stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round;display:inline-block;vertical-align:-2px;margin-right:5px}
.ws.feat .mi{stroke:var(--green)}
.feat-row strong{display:block;font-weight:600;color:var(--green);font-size:1.06rem}
.feat-row p{font-size:.95rem;margin:0;color:var(--muted)}

/* steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:56px;counter-reset:s}
.step{text-align:left}
.step .n{font-family:var(--logo);font-size:.9rem;letter-spacing:.18em;color:var(--pink-deep);margin-bottom:18px;
  display:flex;align-items:center;gap:10px}
.step .n::before{counter-increment:s;content:"0" counter(s);font-size:2.2rem;font-family:var(--logo);font-weight:500;color:var(--green);letter-spacing:0}
.step h3{font-size:1.35rem;margin-bottom:8px}
.step p{color:var(--muted);font-size:.96rem}

/* workshops */
.ws-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:54px}
.ws{background:var(--white);border:1px solid rgba(71,100,79,.1);border-radius:22px;padding:32px 30px;
  display:flex;flex-direction:column;transition:transform .5s var(--ease),box-shadow .5s var(--ease)}
.ws:hover{transform:translateY(-7px);box-shadow:0 28px 56px -30px rgba(47,62,52,.32)}
.ws.feat{background:var(--pink-soft);border-color:transparent}
.ws-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.ws-ic{font-size:2rem}
.tagpill{font-size:.64rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700;padding:6px 13px;border-radius:100px;background:var(--green);color:var(--cream)}
.ws.feat .tagpill{background:var(--pink);color:var(--green)}
.ws h3{font-size:1.45rem;margin-bottom:3px}
.ws .type{font-family:var(--logo);font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;color:var(--sage);margin-bottom:12px}
.ws .desc{color:var(--muted);font-size:.95rem;margin-bottom:18px}
.ws .meta{display:flex;gap:16px;flex-wrap:wrap;font-size:.82rem;color:var(--muted);margin-top:auto;margin-bottom:18px}
.ws .price{font-family:var(--logo);font-weight:600;font-size:1.7rem;color:var(--green);display:flex;align-items:baseline;gap:7px;margin-bottom:18px}
.ws .price span{font-family:var(--body);font-size:.8rem;font-weight:400;color:var(--muted)}
.ws .btn{width:100%}

/* voucher */
.voucher{background:var(--pink);border-radius:var(--r);padding:54px 56px;display:flex;align-items:center;
  justify-content:space-between;gap:36px;flex-wrap:wrap}
.voucher h3{font-size:clamp(1.6rem,3vw,2.4rem)}
.voucher p{color:var(--green);opacity:.82;margin-top:6px;max-width:480px}

/* cafe */
.cafe-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
.cafe-photo{border-radius:24px;overflow:hidden;aspect-ratio:4/4.6;position:sticky;top:96px;box-shadow:0 30px 60px -30px rgba(47,62,52,.4)}
.cafe-photo img{width:100%;height:100%;object-fit:cover}
.cafe p.intro{color:var(--muted);font-size:1.08rem;margin-bottom:30px}
.mcat{margin-bottom:26px}
.mcat h4{font-family:var(--logo);font-weight:500;font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;
  color:var(--sage);margin-bottom:12px;padding-bottom:9px;border-bottom:1.5px solid var(--pink)}
.mitem{display:flex;align-items:baseline;gap:12px;padding:6px 0}
.mitem .nm{color:var(--green);font-weight:500}
.mitem .dots{flex:1;border-bottom:1.5px dotted rgba(71,100,79,.3);transform:translateY(-4px)}
.mitem .pr{font-weight:600;color:var(--sage);white-space:nowrap}
.mitem.note{font-size:.86rem;color:var(--muted);font-style:italic}
.combo{margin-top:28px;background:var(--green);color:var(--cream);border-radius:20px;padding:26px 28px;position:relative}
.combo .cb{position:absolute;top:-11px;left:26px;background:var(--pink);color:var(--green);font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:6px 13px;border-radius:100px}
.combo strong{font-size:1.2rem;color:var(--cream);display:block;margin-bottom:5px}
.combo p{color:rgba(250,246,239,.78);font-size:.94rem;margin-bottom:12px}
.combo .cp{font-family:var(--logo);font-weight:600;font-size:1.6rem;color:var(--pink);display:flex;align-items:baseline;gap:9px}
.combo .cp s{font-family:var(--body);font-size:.82rem;color:rgba(250,246,239,.55);font-weight:400}

/* events */
.ev-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:54px}
.ev{background:var(--white);border:1px solid rgba(71,100,79,.1);border-radius:24px;overflow:hidden;
  display:flex;flex-direction:column;transition:transform .5s var(--ease),box-shadow .5s var(--ease)}
.ev:hover{transform:translateY(-6px);box-shadow:0 28px 56px -30px rgba(47,62,52,.3)}
.ev-photo{height:200px;overflow:hidden;background:var(--cream-2)}
.ev-photo img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}
.ev:hover .ev-photo img{transform:scale(1.05)}
.ev-photo.tint{display:flex;align-items:center;justify-content:center;font-size:3rem}
.ev-photo.t-pink{background:linear-gradient(135deg,var(--pink),var(--pink-soft))}
.ev-photo.t-cream{background:linear-gradient(135deg,var(--cream-2),#e7dcc9)}
.ev-body{padding:28px 30px;display:flex;flex-direction:column;flex-grow:1}
.ev-body h3{font-size:1.45rem;margin-bottom:8px}
.ev-body>p{color:var(--muted);font-size:.96rem;margin-bottom:14px}
.ev-meta{display:flex;gap:16px;flex-wrap:wrap;font-size:.82rem;color:var(--muted);margin-bottom:12px}
.ev-price{font-family:var(--logo);font-weight:600;font-size:1.45rem;color:var(--green);display:flex;align-items:baseline;gap:8px;margin-bottom:3px}
.ev-price span{font-family:var(--body);font-size:.78rem;font-weight:400;color:var(--muted)}
.ev-extra{font-size:.82rem;color:var(--muted);font-style:italic;margin-bottom:16px}
.ev-body .btn{margin-top:auto;align-self:flex-start}

/* testimonial single */
.quote{text-align:center;position:relative;padding:30px 0}
.quote .sticker{margin:0 auto 30px}
.quote blockquote{font-weight:300;font-size:clamp(1.4rem,3.2vw,2.3rem);line-height:1.4;color:var(--green);max-width:880px;margin:0 auto;letter-spacing:-.01em}
.quote .who{margin-top:26px;font-family:var(--logo);letter-spacing:.05em;color:var(--sage)}
.quote .stars{color:var(--pink-deep);letter-spacing:4px;margin-bottom:22px}

/* faq */
.faq-list{max-width:780px;margin:50px auto 0}
.faq-item{border-bottom:1px solid rgba(71,100,79,.16)}
.faq-q{width:100%;background:none;border:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;
  gap:20px;padding:24px 4px;text-align:left;font-weight:600;font-size:1.15rem;color:var(--green)}
.faq-ic{flex-shrink:0;width:30px;height:30px;border-radius:50%;background:var(--pink-soft);color:var(--green);
  display:flex;align-items:center;justify-content:center;font-size:1.3rem;transition:transform .4s var(--ease)}
.faq-item.open .faq-ic{transform:rotate(45deg);background:var(--pink)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .5s var(--ease)}
.faq-a p{padding:0 4px 24px;color:var(--muted);max-width:680px}

/* booking */
.booking{background:var(--cream-2);border-radius:var(--r);padding:64px 40px;text-align:center}
.booking .box{max-width:600px;margin:30px auto 0}
.booking .info{color:var(--muted);margin-bottom:26px}
.booking .cta{display:flex;flex-direction:column;align-items:center;gap:14px}
.booking .or{font-style:italic;color:var(--pink-deep)}
.booking .note{margin-top:26px;font-size:.86rem;color:var(--muted);max-width:460px;margin-left:auto;margin-right:auto}

/* contact */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:stretch}
.cphoto{border-radius:24px;overflow:hidden;min-height:300px}
.cphoto img{width:100%;height:100%;object-fit:cover}
.info-list{margin-top:26px;display:flex;flex-direction:column;gap:2px}
.info-row{display:flex;gap:16px;align-items:flex-start;padding:16px 0;border-top:1px solid rgba(71,100,79,.16)}
.info-row:last-child{border-bottom:1px solid rgba(71,100,79,.16)}
.info-ic{flex-shrink:0;width:42px;height:42px;border-radius:50%;background:var(--pink-soft);display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.info-row strong{display:block;font-weight:600;color:var(--green)}
.info-row p{color:var(--muted);font-size:.95rem;margin:0}
.info-row a{color:var(--sage);border-bottom:1px solid var(--pink)}
.map{border-radius:24px;overflow:hidden;min-height:300px;margin-top:26px;border:1px solid rgba(71,100,79,.1)}
.map iframe{width:100%;height:100%;min-height:300px;border:0;filter:grayscale(.25) sepia(.08)}

/* closing */
.closing{text-align:center;padding:120px 0 30px}
.closing h2{font-size:clamp(2.2rem,5vw,3.6rem);margin-bottom:10px}
.closing h2 .it{font-weight:300;font-style:italic;color:var(--pink-deep)}

/* footer */
.footer{background:var(--green);color:var(--cream);padding:74px 0 34px;margin-top:80px}
.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:44px}
.footer-tag{font-style:italic;color:var(--pink);margin:16px 0 6px}
.footer-addr{color:rgba(250,246,239,.62);font-size:.92rem}
.news{margin-top:24px}.news p{font-size:.9rem;color:rgba(250,246,239,.72);margin-bottom:11px}
.news-form{display:flex;gap:8px;max-width:340px}
.news-form input{flex:1;padding:12px 16px;border-radius:100px;border:1px solid rgba(250,246,239,.24);background:rgba(250,246,239,.06);color:var(--cream);font-family:var(--body);font-size:.88rem}
.news-form input::placeholder{color:rgba(250,246,239,.5)}
.fcol h4{font-family:var(--logo);font-weight:500;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);margin-bottom:16px}
.fcol a,.fcol p{display:block;color:rgba(250,246,239,.72);font-size:.92rem;margin-bottom:9px;transition:color .3s}
.fcol a:hover{color:var(--pink)}
.fcol .cl{color:var(--pink);font-style:italic}
.fbot{margin-top:52px;padding-top:26px;border-top:1px solid rgba(250,246,239,.14);text-align:center;font-size:.84rem;color:rgba(250,246,239,.5)}

/* reveal */
.rv{opacity:0;transform:translateY(30px);transition:opacity .9s var(--ease),transform .9s var(--ease)}
.rv.in{opacity:1;transform:none}
.d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}.d4{transition-delay:.32s}

/* cookie */
.cookie{position:fixed;bottom:20px;left:20px;right:20px;max-width:500px;margin:0 auto;z-index:1500;background:var(--white);
  border:1px solid rgba(71,100,79,.14);border-radius:18px;padding:20px 24px;box-shadow:0 24px 56px -22px rgba(47,62,52,.4);
  transform:translateY(160%);transition:transform .6s var(--ease)}
.cookie.show{transform:none}
.cookie p{font-size:.9rem;color:var(--muted);margin-bottom:13px}
.cookie .row{display:flex;gap:10px}

@media(max-width:980px){
  .hero-grid,.about-grid,.cafe-grid,.contact-grid{grid-template-columns:1fr;gap:46px}
  .hero-photo,.about-photos{max-width:440px;margin:0 auto}
  .cat-grid,.steps{grid-template-columns:repeat(2,1fr)}
  .ws-grid{grid-template-columns:repeat(2,1fr)}
  .cafe-photo{position:static}
  .footer-grid{grid-template-columns:1fr 1fr;gap:32px}
}
@media(max-width:640px){
  .wrap{padding:0 20px}
  .nav-menu{position:fixed;inset:0 0 0 auto;width:82%;max-width:300px;background:var(--cream);flex-direction:column;
    align-items:flex-start;justify-content:center;gap:22px;transform:translateX(100%);transition:transform .5s var(--ease);
    box-shadow:-20px 0 60px -20px rgba(47,62,52,.3);padding:40px 34px}
  .nav-menu.open{transform:none}
  .nav-menu .nav-link{font-size:1.15rem}
  .nav-menu .nav-cta{margin-top:8px}
  .burger{display:flex;z-index:1000}
  .topbar{font-size:.66rem;letter-spacing:.1em;padding:8px 14px;line-height:1.5}
  .alertbar{font-size:.8rem;padding:10px 14px;gap:8px}
  .cat-grid,.steps,.ws-grid,.ev-grid,.footer-grid{grid-template-columns:1fr}
  .sec,.tagline,.closing{padding:56px 0}
  .sec-sm{padding:48px 0}
  .voucher,.booking{padding:36px 24px}
  /* hero */
  .hero{padding:48px 0 20px}
  .hero h1{font-size:clamp(2.7rem,11vw,3.4rem)}
  .hero .lead{margin:20px 0 28px;font-size:1.05rem}
  .hero-cta{flex-direction:column;align-items:stretch}
  .hero-cta .btn{width:100%}
  .hero-photo{max-width:340px}
  .hero-photo .ph{border-radius:200px 200px 26px 26px}
  .sticker{width:104px;height:104px}
  .hero-photo .sticker{bottom:-18px;left:-12px}
  /* category cards become wider/shorter so they aren't huge */
  .cat{aspect-ratio:16/11}
  /* about overlap photo smaller + inset so it never clips */
  .about-photos .small{width:46%;bottom:-20px;right:-6px;border-width:5px}
  /* typography trims */
  .lead{font-size:1.05rem}
  .h-lg{font-size:clamp(1.9rem,7.5vw,2.4rem)}
  .tagline p{font-size:clamp(1.7rem,8vw,2.3rem)}
  .quote blockquote{font-size:clamp(1.3rem,6.2vw,1.8rem)}
  .faq-q{font-size:1.05rem;padding:20px 2px;gap:14px}
  .step .n::before{font-size:1.9rem}
  /* cafe combo + menu spacing */
  .cafe-grid{gap:38px}
  /* voucher: stack + full button */
  .voucher{flex-direction:column;align-items:flex-start;text-align:left;gap:22px}
  .voucher .btn{width:100%}
  /* events keep readable */
  .ev-photo{height:190px}
  /* booking buttons full width */
  .booking .cta .btn{width:100%;max-width:340px}
  /* footer newsletter + columns */
  .footer{padding:60px 0 30px;margin-top:60px}
  .footer-grid{gap:30px}
  .news-form{flex-direction:column;max-width:100%}
  .news-form .btn{width:100%}
  .fbot{margin-top:40px;font-size:.78rem}
  /* contact spacing */
  .contact-grid{gap:40px}
  .map,.cphoto{min-height:240px}
  /* cookie banner mobile */
  .cookie{left:14px;right:14px;bottom:14px;padding:18px 20px}
  .cookie .row{flex-direction:column}
  .cookie .row .btn{width:100%}
}
@media(max-width:380px){
  .wrap{padding:0 16px}
  .hero h1{font-size:2.4rem}
  .nav-in{padding:14px 16px}
  .logo--nav{font-size:1.25rem}
}
/* respect reduced motion */
@media(prefers-reduced-motion:reduce){
  .sticker{animation:none}
  .rv{transition:none;opacity:1;transform:none}
  *{scroll-behavior:auto}
}
