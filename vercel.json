<!-- about -->
<section class="sec about" id="about" style="padding-top:30px">
  <div class="wrap about-grid">
    <div class="about-photos rv">
      <div class="big"><img src="/images/interior_wide.jpg" alt="LOVE Creative Café Interieur"></div>
      <div class="small"><img src="/images/seating.jpg" alt="Sitzbereich im Café"></div>
    </div>
    <div>
      <span class="eyebrow rv">Über uns</span>
      <h2 class="h-lg rv d1">Ein Raum für Kreativität,<br>Verbindung &amp; Ruhe</h2>
      <p class="rv d2">Unser gemütliches Studio in Au am Zürichsee lädt alle Altersgruppen ein, sich kreativ auszuleben. Wähle aus einer grossen Auswahl an Keramikstücken, bemale sie mit leuchtenden Farben und geniesse dabei einen feinen Kaffee oder Smoothie.</p>
      <p class="rv d2">Ob alleine, mit Freunden oder der Familie — bei LOVE Creative entstehen nicht nur wunderschöne Keramikstücke, sondern auch besondere Erinnerungen.</p>
      <div class="feat rv d3">
        <div class="feat-row"><div class="feat-ic"><img src="/images/badge_studio.jpg" alt=""></div><div><strong>Kreativ-Studio</strong><p>Keramik, Töpfern, Schmuck &amp; mehr</p></div></div>
        <div class="feat-row"><div class="feat-ic"><img src="/images/badge_coffee.jpg" alt=""></div><div><strong>Gemütliches Café</strong><p>Kaffee, Smoothies &amp; hausgemachte Taarten</p></div></div>
        <div class="feat-row"><div class="feat-ic"><img src="/images/badge_view.jpg" alt=""></div><div><strong>Seesicht</strong><p>Kreativ sein mit Blick auf den Zürichsee</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- how it works -->
<section class="sec-sm">
  <div class="wrap center">
    <span class="eyebrow rv">So einfach geht's</span>
    <h2 class="h-lg rv d1">In 4 Schritten zu deinem Kunstwerk</h2>
    <div class="steps" style="text-align:left">
      <div class="step rv d1"><div class="n">Wähle</div><h3>Wähle dein Stück</h3><p>Von Tassen bis Schalen — wähle aus über 100 Rohlingen dein Lieblingsstück.</p></div>
      <div class="step rv d2"><div class="n">Bemale</div><h3>Bemale &amp; geniesse</h3><p>Nimm Platz, geniesse einen Kaffee und gestalte dein eigenes Design.</p></div>
      <div class="step rv d3"><div class="n">Brennen</div><h3>Wir glasieren &amp; brennen</h3><p>Wir übernehmen das Glasieren und Brennen — für die perfekte Oberfläche.</p></div>
      <div class="step rv d4"><div class="n">Abholen</div><h3>Hol dein Werk ab</h3><p>Nach 2–3 Wochen ist dein einzigartiges Keramikstück bereit.</p></div>
    </div>
  </div>
</section>

